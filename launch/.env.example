# Public site
SITE_URL=http://localhost:5173
NEXT_PUBLIC_APP_NAME=CLOX
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Upstream Nest API (server-only; used by Next route handlers)
API_BASE_URL=http://localhost:3000/v1

# Optional browser fallback if calling API directly (prefer same-origin /api/leads/*)
NEXT_PUBLIC_API_BASE_URL=

# AI site guide (server-only)
# Providers: groq | openai | anthropic | mock
# Recommended (Groq only): set AI_PROVIDER=groq and GROQ_API_KEY
AI_PROVIDER=groq
# Groq-hosted OpenAI GPT open-weight models:
#   openai/gpt-oss-20b  (fast, good default)
#   openai/gpt-oss-120b (stronger)
AI_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
